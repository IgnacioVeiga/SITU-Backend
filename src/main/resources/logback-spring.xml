<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Appender con colores ANSI -->
    <appender name="COLORED_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="COLORED_CONSOLE" />
    </root>

    <logger name="com.backend.situ" level="DEBUG" additivity="false">
        <appender-ref ref="COLORED_CONSOLE"/>
    </logger>

<!--    <logger name="com.backend.situ.auth.component" level="INFO" additivity="false">-->
<!--        <appender-ref ref="COLORED_CONSOLE"/>-->
<!--    </logger>-->
</configuration>
