# Environment mode
APP_ENV=development

# Database
DB_URL=jdbc:postgresql://localhost:5432/situ_dev
DB_USERNAME=user_admin
DB_PASSWORD=admin@123

# Mail (used to send temporary password on signup)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=app-password-or-token

# Security: CORS and auth cookie
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
COOKIE_SECURE=false
COOKIE_MAX_AGE_HOURS=24

# Security: JWT
# Use at least 32 bytes. Base64 is recommended but plain text also works in dev.
JWT_SECRET=replace-with-a-strong-secret-min-32-bytes
JWT_EXPIRATION_HOURS=24
JWT_RENEW_THRESHOLD_MINUTES=15

# Security: encryption key for sensitive complaint contact data
DATA_ENCRYPTION_KEY=replace-with-a-strong-encryption-key
