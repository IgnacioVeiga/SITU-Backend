# ------------------------------------------------------------------------------
# Runtime profile
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
# Optional mirror for app-level telemetry/logging.
APP_ENV=dev

# ------------------------------------------------------------------------------
# Database connection
# ------------------------------------------------------------------------------
# Local example:
DB_URL=jdbc:postgresql://localhost:5432/situ_dev

# Cloud example (uncomment and adapt host/port/db):
# DB_URL=jdbc:postgresql://your-host:5432/your-db?sslmode=require

DB_USERNAME=user_admin
DB_PASSWORD=admin@123

# ------------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call this API)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ------------------------------------------------------------------------------
# Access token (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET must have at least 32 characters.
# Generate example: openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-secret-min-32-bytes

# Access token lifetime in seconds (recommended short-lived)
JWT_ACCESS_EXPIRATION_SECONDS=900

# ------------------------------------------------------------------------------
# Refresh session policy
# ------------------------------------------------------------------------------
# Lifetime without "remember me"
AUTH_REFRESH_EXPIRATION_SECONDS=43200

# Lifetime with "remember me" (must be >= AUTH_REFRESH_EXPIRATION_SECONDS)
AUTH_REFRESH_REMEMBER_EXPIRATION_SECONDS=2592000

# ------------------------------------------------------------------------------
# Refresh cookie settings
# ------------------------------------------------------------------------------
AUTH_REFRESH_COOKIE_NAME=situ_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Sensitive complaint data encryption
# ------------------------------------------------------------------------------
# Must be long and random in non-dev environments.
DATA_ENCRYPTION_KEY=replace-with-a-strong-encryption-key

# ------------------------------------------------------------------------------
# Complaint tracking token hash secret
# ------------------------------------------------------------------------------
# Used to hash tracking tokens before lookup in DB (HMAC-SHA256).
TRACKING_TOKEN_HASH_SECRET=replace-with-a-different-strong-secret

# ------------------------------------------------------------------------------
# Mail (used for signup and complaint state notifications)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=app-password-or-token

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_SECURITY_LEVEL=INFO

# ------------------------------------------------------------------------------
# Time zone baseline on server side (default: Buenos Aires)
# ------------------------------------------------------------------------------
APP_TIMEZONE=America/Argentina/Buenos_Aires
